# Copy this file to backend/.env and fill in your own values. Never commit .env.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/medcare?appName=Cluster0
JWT_SECRET=change-me
PORT=5000
# Optional: only if you get "querySrv ECONNREFUSED" on your network (comma-separated)
# DNS_SERVERS=8.8.8.8,1.1.1.1
